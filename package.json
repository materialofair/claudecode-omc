{
  "name": "claudecode-omc",
  "version": "5.14.0",
  "description": "Claude Code harness — best-practice skills, agents, hooks, and configs from multiple sources",
  "bin": {
    "omc-manage": "bin/omc-manage.js"
  },
  "files": [
    "bin",
    "src",
    ".local",
    ".omc-curation",
    "bundled",
    "scripts",
    "templates",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "setup": "node bin/omc-manage.js setup",
    "doctor": "node bin/omc-manage.js doctor",
    "guidelines:optimize": "node bin/omc-manage.js guidelines optimize",
    "guidelines:apply": "node bin/omc-manage.js guidelines apply",
    "source:list": "node bin/omc-manage.js source list",
    "source:sync": "node bin/omc-manage.js source sync",
    "source:status": "node bin/omc-manage.js source status",
    "source:inspect": "node bin/omc-manage.js source inspect",
    "plan:install": "node bin/omc-manage.js plan install",
    "skill:list": "node bin/omc-manage.js skill list",
    "skill:conflicts": "node bin/omc-manage.js skill conflicts",
    "bundle": "node scripts/bundle-upstream.js",
    "prepublishOnly": "npm test && npm run bundle",
    "postinstall": "node scripts/post-install-message.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "claude-code",
    "oh-my-claudecode",
    "superpowers",
    "skills",
    "agents",
    "hooks",
    "harness",
    "multi-source",
    "ai-agent",
    "best-practices"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/materialofair/claudecode-omc.git"
  },
  "homepage": "https://github.com/materialofair/claudecode-omc#readme",
  "bugs": {
    "url": "https://github.com/materialofair/claudecode-omc/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
